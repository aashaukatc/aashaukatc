{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftabshaukat.me/schemas/application.schema.json",
  "title": "Aftab Shaukat Career Application",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "status", "job", "resume", "coverLetter", "alignment", "profileUpdates"],
  "properties": {
    "$schema": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["draft", "ready", "submitted", "closed"] },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "role", "url", "location", "workMode", "keywords"],
      "properties": {
        "company": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "location": { "type": "string" },
        "workMode": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "resume": {
      "type": "object",
      "required": ["basics", "skills"],
      "properties": {
        "basics": {
          "type": "object",
          "required": ["label", "summary"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        "skills": { "type": "array", "minItems": 1 }
      }
    },
    "coverLetter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "recipient", "salutation", "paragraphs", "closing"],
      "properties": {
        "date": { "type": "string", "minLength": 1 },
        "recipient": { "type": "string", "minLength": 1 },
        "salutation": { "type": "string", "minLength": 1 },
        "paragraphs": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
        "closing": { "type": "string", "minLength": 1 }
      }
    },
    "alignment": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "evidence", "source"],
        "properties": {
          "requirement": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "pattern": "^resumes/resume\\.json#" }
        }
      }
    },
    "profileUpdates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linkedinHeadline", "linkedinAboutAddendum", "platformNotes"],
      "properties": {
        "linkedinHeadline": { "type": "string" },
        "linkedinAboutAddendum": { "type": "string" },
        "platformNotes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "applicationQuestions": { "type": "array", "items": { "type": "string" } }
  }
}
